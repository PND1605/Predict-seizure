    lr_init:       float = 5e-4
    lr_min:        float = 1e-5
    alpha_fn:      float = 3.0        # FN penalty (bỏ sót seizure)
    alpha_fp:      float = 1.0        # FP penalty (báo giả)

    # ── I/O tuning cho HDF5 (Xds cache) — ĐÃ THÊM ─────────────────────────────
    # VẤN ĐỀ đo được thực nghiệm: bản Xds cache (precompute decimate 1 lần)
    # kỳ vọng giảm CPU nhưng lại làm CHẬM HƠN ~1.7-1.85x/epoch so với bản
    # không cache (đo trên 6/7 fold, hệ số lặp lại đều đặn → lỗi hệ thống,
    # không phải nhiễu môi trường). 2 nguyên nhân:
    #   1) make_generator() đọc TOÀN BỘ batch từ "Xds" RỒI đọc thêm 1 lần nữa
    #      từ "X" cho phần preictal cần augment — với train set balance 2:1
    #      (~33% preictal), GẦN NHƯ MỌI batch đều trả kích hoạt đọc kép này
    #      → lãng phí I/O đọc "Xds" cho các dòng sẽ bị ghi đè ngay sau đó.
    #      → ĐÃ SỬA: chỉ đọc "Xds" cho phần KHÔNG augment, đọc "X" CHỈ cho
    #      phần augment — mỗi window giờ chỉ đọc đúng 1 lần từ đúng 1 dataset.
    #   2) "Xds" tạo với chunks=True (auto-chunk mặc định) — không đảm bảo
    #      chunk = đúng 1 window, nên 1 lần đọc fancy-index (64 index NGẪU
    #      NHIÊN do shuffle mỗi epoch) có thể phải load nhiều chunk chồng lấn
    #      dữ liệu thừa. Tổng dung lượng file cũng tăng thêm ~10GB (Xds) bên
    #      cạnh X gốc (~21GB) — nếu vượt quá RAM cache của OS, mỗi epoch phải
    #      seek đĩa lặp lại giữa 2 dataset lớn (cache thrashing).
    #      → ĐÃ SỬA: chunk "Xds" tường minh = ĐÚNG 1 window/chunk (tối ưu cho
    #      truy cập ngẫu nhiên theo batch, đánh đổi write throughput lúc
    #      precompute — chấp nhận được vì chỉ chạy 1 lần).
    #      → THÊM: tăng h5py raw-data chunk cache (rdcc_nbytes/rdcc_nslots)
    #      khi mở file để đọc trong generator, giảm số lần evict/re-read
    #      chunk giữa các batch trong cùng 1 epoch.
    xds_chunk_rows:   int = 1            # số window/chunk của "Xds" (1 = tối ưu random-read)
    h5_rdcc_mb:       int = 512          # kích thước raw chunk cache (MB) khi mở file để đọc
    h5_rdcc_nslots:   int = 1_000_003    # số slot hash cho chunk cache (số nguyên tố, theo khuyến nghị h5py)
    use_xds_cache:    bool = True        # tắt để quay lại decimate runtime (VD nếu đĩa quá chậm/HDD)

    # ── PA1: Firing Power post-processing (thay N/K voting thô) ──────────────
    # Firing power = tỷ lệ window "dương tính" (score ≥ thr_on) trong 1 cửa sổ
    # trượt dài fp_window_s giây gần nhất → mượt hơn N/K voting cũ (vốn chỉ
    # xét 5 window ≈ 25s, dễ phản ứng với nhiễu tức thời gây FAR cao).
    fp_window_s:   int   = 60         # độ dài cửa sổ tính firing power (s)
    thr_off_min:   float = 0.02       # chặn thr_off=0 (bug v3)
    suppression_s: int   = 900        # 15 min (không dùng = PRE_ICTAL để tránh triệt tiêu alarm quá lâu)

    # Evaluation — CHỈ dùng để vẽ đường mốc tham khảo trên plot/log, KHÔNG còn
    # dùng để chọn threshold (grid-search đã bị loại bỏ hoàn toàn, xem bên dưới).
    sens_target: float = 0.80
    far_target:  float = 0.50

    # ── Probability Calibration (Platt scaling) — chạy TRƯỚC threshold selection
    # Xem fit_platt_scaling() để biết nguyên lý đầy đủ. Bật mặc định: kết hợp
    # với threshold_mode="relative" (percentile vẫn hoạt động tốt sau khi
    # calibrate, vì percentile không phụ thuộc thang đo tuyệt đối) — calibration
    # giải quyết vấn đề gốc (thang đo score khác nhau giữa các fold), percentile
    # tiếp tục xử lý vấn đề tỷ lệ preictal khác nhau giữa các file. 2 fix bổ trợ
    # nhau, không thay thế nhau.
    use_calibration: bool = True

    # ── Platt scaling guard — ĐÃ THÊM (fix bug Fold 6: calibration suy biến
    # khi val mất cân bằng cực đoan, VD chỉ 58/418 window interictal) ────────
    # VẤN ĐỀ quan sát thực nghiệm: khi 1 lớp trong val quá ít hoặc raw score
    # không có quan hệ tin cậy với nhãn trên val nhỏ, LogisticRegression vẫn
    # "fit thành công" (không lỗi) nhưng hội tụ về nghiệm gần-hằng-số (predict
    # gần bằng tỷ lệ lớp ưu thế cho MỌI input) — VD Fold 6: raw val trải dài
    # [0.035,0.693] nhưng calibrated lại co cụm [0.847,0.875] (rộng 0.028) →
    # threshold chọn trên đầu ra suy biến này vô nghĩa hoàn toàn.
    # SỬA: (1) chặn TRƯỚC khi fit nếu lớp thiểu số quá nhỏ để ước lượng đáng
    # tin cậy; (2) chặn SAU khi fit nếu dải xác suất hiệu chỉnh trên CHÍNH val
    # quá hẹp (dấu hiệu trực tiếp của suy biến, không cần đoán nguyên nhân).
    # Cả 2 trường hợp đều fallback về raw score (giữ đúng thứ hạng, vẫn dùng
    # được với threshold percentile) thay vì dùng calibration sai lệch.
    platt_min_class_n:          int   = 30     # số window tối thiểu của lớp THIỂU SỐ trong val
    platt_min_calibrated_range: float = 0.05   # dải [min,max] tối thiểu của xác suất hiệu chỉnh trên val

    # ── Tách val cho EarlyStopping khỏi val cho threshold/calibration — ĐÃ
    # THÊM (chống "peeking", Kerr et al. 2024 Front Neurol) ──────────────────
    # VẤN ĐỀ: val_idx của LOSO-CV (1 seizure file) trước đây dùng CHO CẢ
    # EarlyStopping (chọn model) LẪN Platt scaling + threshold-selection
    # (đánh giá/hiệu chỉnh model đã chọn) — đúng lỗi "peeking" kinh điển: mô
    # hình "tốt nhất" được chọn dựa trên val, rồi lại dùng CHÍNH val đó để
    # quyết định ngưỡng, không còn dữ liệu độc lập nào để việc chọn ngưỡng là
    # khách quan. SỬA: trích inner_val_frac% từ TRAIN (không đụng val_idx/
    # test_idx của LOSO) làm tín hiệu EarlyStopping riêng — val_idx của LOSO
    # giờ CHỈ dùng cho Platt scaling/threshold, đúng vai trò "unseen" ban đầu.
    inner_val_frac: float = 0.15   # tỷ lệ train dùng làm inner-val cho EarlyStopping

    # ── Threshold selection — ĐÃ BỎ HOÀN TOÀN grid-search trên val ────────────
    # VẤN ĐỀ với grid-search cũ: val của mỗi fold LOSO-CV chỉ có ĐÚNG 1 seizure
    # event → tối ưu trực tiếp Sensitivity/FAR trên val cực dễ đạt "Sens=1.0
    # giả" (chỉ cần alarm trúng đúng 1 event đó), KHÔNG generalize sang test
    # (bằng chứng thực nghiệm: chb01 Fold 2 AUC=0.904 nhưng threshold chọn trên
    # val làm Sensitivity test=0; chb03 4/7 fold "Sens=1.0" đều đến từ thr_on
    # cực thấp 0.10-0.40 chọn trên val, không phản ánh model thật sự tốt).
    # → Thay bằng 3 chế độ không nhìn event/nhãn để chọn (xem select_threshold):
    #   "absolute" | "relative" | "learn_then_test" (khuyến nghị, xem bên dưới)
    threshold_mode: str = "learn_then_test"

    # ── Chế độ LEARN_THEN_TEST (Angelopoulos et al. 2022; áp dụng cho seizure
    # FAR bởi Segal et al. 2023/2025, Frontiers in Neuroscience) — THAY THẾ
    # percentile thô ("relative") bằng lựa chọn ngưỡng có ĐẢM BẢO THỐNG KÊ
    # hình thức (finite-sample), thay vì chỉ là điểm ước lượng (point estimate).
    #
    # VẤN ĐỀ của "relative" (percentile thô trên interictal): percentile là
    # ước lượng điểm (point estimate) — KHÔNG có gì đảm bảo risk THẬT (tỷ lệ
    # interictal vượt ngưỡng trên toàn bộ population) sẽ ≤ target khi mẫu val
    # nhỏ (58-611 window/fold trong thực nghiệm chb01). Bằng chứng thực
    # nghiệm: dù đã sửa anchor + sửa bug clamp, FAR vẫn plateau ~1.4-1.6/h
    # qua 3 công thức percentile khác nhau — percentile đã hết dư địa.
    #
    # NGUYÊN LÝ: với mỗi ứng viên thr_on, coi risk(thr_on) = P(score
    # interictal ≥ thr_on) là 1 đại lượng cần KIỂM ĐỊNH THỐNG KÊ (không phải
    # chỉ ước lượng), dùng p-value Hoeffding-Bentkus (HB, Bates et al. 2021)
    # cho loss bị chặn trong [0,1]:
    #   H0: risk(thr_on) > ltt_target_risk  (ứng viên "TỆ" — không kiểm soát được)
    #   Bác bỏ H0 (chấp nhận thr_on) khi p_HB ≤ ltt_delta
    # Do risk(thr_on) ĐƠN ĐIỆU GIẢM khi thr_on tăng, dùng Fixed Sequence
    # Testing (FST): kiểm định các ứng viên theo thứ tự TỪ BẢO THỦ NHẤT
    # (thr_on cao, risk≈0, luôn pass) GIẢM DẦN, DỪNG ở ứng viên đầu tiên bị
    # bác bỏ (p > delta) — chọn ứng viên NỚI NHẤT (thr_on nhỏ nhất) vừa còn
    # pass. FST kiểm soát đúng family-wise error rate ở mức delta MÀ KHÔNG
    # CẦN hiệu chỉnh Bonferroni (nhờ tính đơn điệu) — mạnh hơn test độc lập
    # từng điểm. Đã kiểm chứng bằng Monte Carlo (Beta(2,5), n=300 và n=58 mô
    # phỏng đúng cỡ mẫu Fold 6 thật): tỷ lệ risk THẬT vượt target luôn ≤
    # ltt_delta qua hàng trăm lần lặp — percentile thô KHÔNG có đảm bảo này.
    #
    # Trade-off: ngưỡng LTT LUÔN ≥ percentile thô tương ứng (dè dặt hơn để bù
    # sai số ước lượng mẫu nhỏ) → Sensitivity có thể giảm nhẹ ở fold mẫu quá
    # nhỏ, đổi lấy FAR có đảm bảo thống kê thay vì may rủi.
    ltt_target_risk: float = 0.03   # risk mục tiêu = tỷ lệ window interictal được PHÉP vượt thr_on
    ltt_delta:       float = 0.10   # mức tin cậy 1-delta = 90% rằng risk thật <= ltt_target_risk

    # Chế độ ABSOLUTE: 1 con số cố định cho MỌI fold. Nhiều nghiên cứu seizure
    # prediction cố định threshold Firing Power thay vì tối ưu (tránh thêm 1
    # tham số tune trên dữ liệu quá ít). NHƯỢC ĐIỂM đã thấy thực nghiệm: giả
    # định mọi model (train riêng biệt/fold) có cùng thang đo score — SAI khi
    # model train ngắn (9-13/30 epoch) → 4/7 fold chb01 mất alarm hoàn toàn vì
    # score không bao giờ vượt 0.5 (xem log 10/08 threshold cố định 0.5/0.4).
    fixed_thr_on:  float = 0.50
    fixed_thr_off: float = 0.40

    # Chế độ RELATIVE (mặc định, khuyến nghị) — ĐÃ SỬA LẦN 2 (anchor đổi từ
    # "preictal_frac của TOÀN val" → "phân phối điểm số CHỈ trên interictal
    # của val"):
    #
    # VẤN ĐỀ của bản trước (percentile suy từ preictal_frac): preictal_frac
    # của val dao động CỰC MẠNH giữa các fold — quan sát thực nghiệm chb01:
    # 0.095 (fold 5) → 0.861 (fold 6), vì val chỉ có ĐÚNG 1 file/1 seizure,
    # SOP thích ứng + độ dài file khác nhau khiến tỷ lệ này gần như NGẪU
    # NHIÊN, không phản ánh khả năng phân biệt thật của model:
    #   - Fold 5: preictal_frac=0.095 (thấp bất thường) → percentile bị đẩy
    #     lên 90.5 → thr_on quá cao so với score thật của vùng preictal →
    #     Sensitivity=0.000 trên CẢ VAL LẪN TEST dù AUC-ROC test 0.69-0.93
    #     (model vẫn phân biệt tốt, chỉ threshold sai).
    #   - Fold 6: preictal_frac=0.861 (cao bất thường) → percentile chỉ 13.9
    #     → thr_on quá thấp → FAR test vọt lên 1.66-3.54/h, cao nhất trong
    #     mọi fold.
    #
    # SỬA: percentile giờ tính trên PHÂN PHỐI ĐIỂM SỐ CỦA RIÊNG INTERICTAL
    # (y_val==0), không còn dùng preictal_frac để suy ra percentile:
    #   thr_on  = percentile thứ (100 - interictal_fa_pct) của score INTERICTAL
    #   thr_off = percentile thấp hơn thr_on đúng relative_pct_margin điểm %
    # Lý do tốt hơn:
    #   1) Số window interictal LUÔN nhiều (hàng trăm-nghìn) và ổn định giữa
    #      các fold, không phụ thuộc SOP/độ dài file preictal đặc thù ngẫu
    #      nhiên như preictal_frac.
    #   2) Nhắm THẲNG vào đại lượng cần kiểm soát (tỷ lệ interictal vượt
    #      ngưỡng ≈ nguồn gốc trực tiếp của FAR), thay vì suy luận gián tiếp
    #      qua tỷ lệ preictal.
    #   3) Không phụ thuộc độ dài/đặc thù của vùng preictal (vốn là nguồn
    #      gây lệch ở cả fold 5 và fold 6) → tự động ổn định cho cả 2 case
    #      cực đoan trên mà KHÔNG cần fold-specific hack.
    #   4) Vẫn KHÔNG nhìn vào việc trúng/trượt 1 seizure event để chọn
    #      ngưỡng (chỉ dùng nhãn y==0, là nhãn ổn định, không phải kết quả
    #      pass/fail) → giữ nguyên tinh thần chống overfit của Fix #1.
    interictal_fa_pct:   float = 3.0   # % interictal-window val được PHÉP vượt thr_on
    relative_pct_margin: float = 5.0   # khoảng cách (điểm %) giữa pct_on và pct_off


