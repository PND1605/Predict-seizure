def _hdf5_is_complete(hdf5_path: str) -> bool:
    """
    Kiểm tra HDF5 đã preprocessing XONG HOÀN TOÀN chưa — không chỉ file có
    tồn tại. ĐÃ SỬA: trước đây chỉ os.path.exists() → nếu lần chạy trước bị
    dừng giữa chừng (Ctrl+C/crash) sau khi mới ghi vài EDF, file dở dang vẫn
    "tồn tại" và bị coi nhầm là hoàn tất → LOSO-CV chạy với dữ liệu thiếu.
    """
    if not os.path.exists(hdf5_path):
        return False
    try:
        with h5py.File(hdf5_path, "r") as hf:
            return bool(hf.attrs.get("preprocessing_complete", False))
    except OSError:
        # File tồn tại nhưng hỏng/không mở được (VD bị kill giữa lúc ghi) →
        # coi như chưa hoàn tất, cần preprocessing lại.
        return False


if __name__ == "__main__":
    cfg = Config()

    # ── Preprocessing (skip CHỈ KHI HDF5 đã ghi xong hoàn toàn) ──────────────
    if not _hdf5_is_complete(cfg.hdf5_path):
        if os.path.exists(cfg.hdf5_path):
            log.warning(f"HDF5 '{cfg.hdf5_path}' tồn tại nhưng KHÔNG hoàn tất "
                        f"(thiếu flag preprocessing_complete — có thể do lần "
                        f"chạy trước bị dừng giữa chừng). Xóa và chạy lại "
                        f"preprocessing từ đầu.")
            os.remove(cfg.hdf5_path)
        log.info("Chạy preprocessing...")
        run_preprocessing(cfg)
    else:
        log.info(f"HDF5 '{cfg.hdf5_path}' đã hoàn tất — bỏ qua preprocessing.")
        log.warning("Nếu bạn đã sửa dataset hoặc config, xóa file HDF5 và chạy lại.")

    # ── LOSO-CV ───────────────────────────────────────────────────────────────
    run_loso_cv(cfg)
