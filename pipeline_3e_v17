def run_preprocessing(cfg: Config):
    """Chạy toàn bộ tiền xử lý và lưu dữ liệu thô vào file định dạng HDF5."""
    log.info(f"{'='*60}")
    log.info(f"PREPROCESSING — Bệnh nhân: {cfg.patient}")
    log.info(f"{'='*60}")

    seizure_map = load_all_seizure_maps(cfg)
    edf_files   = sorted([
        os.path.join(root, f)
        for root, _, files in os.walk(cfg.dataset_path)
        if cfg.patient in os.path.basename(root)
        for f in files if f.endswith(".edf")
    ])
    if not edf_files:
        raise FileNotFoundError(f"Không tìm thấy file EDF tại {cfg.dataset_path}")

    ref_res = None
    for ef in edf_files:
        ref_res = load_edf(ef, cfg)
        if ref_res is not None:
            break
    if ref_res is None:
        raise RuntimeError("Không nạp được file EDF tham chiếu.")
    n_ch   = ref_res[0].shape[0]
    win_s  = cfg.win_samples
    n_bands = len(cfg.bands)
    del ref_res
    gc.collect()

    band_sos = design_band_filters(cfg.bands, cfg.sfreq)

    with h5py.File(cfg.hdf5_path, "w") as hf:
        hf.create_dataset("X",       shape=(0, n_bands, n_ch, win_s), maxshape=(None, n_bands, n_ch, win_s), dtype="float32", chunks=True)
        hf.create_dataset("SE",      shape=(0, n_ch),                 maxshape=(None, n_ch),                 dtype="float32", chunks=True)
        hf.create_dataset("SPE",     shape=(0, n_ch),                 maxshape=(None, n_ch),                 dtype="float32", chunks=True)
        hf.create_dataset("PE",      shape=(0, n_ch),                 maxshape=(None, n_ch),                 dtype="float32", chunks=True)
        hf.create_dataset("y",       shape=(0,),                      maxshape=(None,),                      dtype="float32", chunks=True)
        hf.create_dataset("tts",     shape=(0,),                      maxshape=(None,),                      dtype="float32", chunks=True)
        hf.create_dataset("t",       shape=(0,),                      maxshape=(None,),                      dtype="float32", chunks=True)
        hf.create_dataset("file_id", shape=(0,),                      maxshape=(None,),                      dtype="int32",   chunks=True)
        hf.attrs.update({"n_channels": n_ch, "sfreq": cfg.sfreq, "patient": cfg.patient})

        written = 0
        file_names = []

        for edf_path in tqdm(edf_files, desc="Tiến trình xử lý EDF"):
            res = load_edf(edf_path, cfg)
            if res is None:
                continue
            data, sfreq = res
            windows, st = make_windows(data, cfg)
            del data; gc.collect()

            if len(windows) == 0:
                continue

            fname  = os.path.basename(edf_path)
            file_seizures = seizure_map.get(fname, [])

            sop_map = None
            if cfg.adaptive_sop and file_seizures:
                energy_probe = compute_broadband_energy(windows)
                sop_map = select_adaptive_sop(energy_probe, st, file_seizures, cfg)
                del energy_probe

            labels, tts = label_windows(st, file_seizures, cfg, sop_map=sop_map)
            mask = labels >= 0.0
            windows, labels, tts, st = windows[mask], labels[mask], tts[mask], st[mask]

            if len(windows) == 0:
                continue

            SE, SPE, PE = compute_entropy_batch(windows, sfreq, cfg)
            Xm = normalize_multiband(
                np.stack([multiband_window(w, band_sos) for w in windows])
            )

            file_id = len(file_names)
            file_names.append(fname)
            fid_arr = np.full(len(Xm), file_id, dtype=np.int32)

            nt = written + len(Xm)
            for k in ("X", "SE", "SPE", "PE", "y", "tts", "t", "file_id"):
                hf[k].resize(nt, axis=0)
            hf["X"][written:nt]       = Xm
            hf["SE"][written:nt]      = SE
            hf["SPE"][written:nt]     = SPE
            hf["PE"][written:nt]      = PE
            hf["y"][written:nt]       = labels
            hf["tts"][written:nt]     = tts
            hf["t"][written:nt]       = st
            hf["file_id"][written:nt] = fid_arr
            written = nt
            del Xm, SE, SPE, PE, labels; gc.collect()

        hf.attrs["file_names"] = json.dumps(file_names)
        hf.attrs["preprocessing_complete"] = True

    log.info(f"Hoàn thành tiền xử lý | Tổng số cửa sổ: {written}")
    return cfg.hdf5_path


# ==============================================================================
# MODULE 6: DỮ LIỆU ĐẦU VÀO, DATA AUGMENTATION & GENERATOR
# ==============================================================================
def _transform(x: np.ndarray, ds_factor: int) -> np.ndarray:
    """Hạ mẫu tín hiệu theo hệ số ds_factor và định hình lại kích thước ma trận."""
    x_ds = sp_decimate(x, ds_factor, axis=2, ftype="fir", zero_phase=True) if ds_factor > 1 else x
    return x_ds.transpose(2, 0, 1).reshape(x_ds.shape[2], -1)


def _augment_window(x: np.ndarray, rng: np.random.RandomState) -> np.ndarray:
    """Tăng cường dữ liệu cục bộ bằng bộ tạo số ngẫu nhiên độc lập."""
    x = x.copy()
    op = rng.randint(4)
    if op == 0:
        x += rng.normal(0, 0.01 * (x.std() + 1e-6), x.shape).astype(np.float32)
    elif op == 1:
        x *= np.float32(rng.uniform(0.85, 1.15))
    elif op == 2:
        x = np.roll(x, rng.randint(-10, 10), axis=2)
    elif op == 3:
        flip = rng.rand(x.shape[1]) < 0.25
        x[:, flip, :] *= -1
    return x.astype(np.float32)


def ensure_xds_cache(h5path: str, cfg: Config, time_ds: int, feat_sz: int):
    """Tính toán trước hạ mẫu và lưu vào dataset Xds trong HDF5 để tối ưu hóa I/O."""
    if not cfg.use_xds_cache:
        with h5py.File(h5path, "a") as hf:
            if "Xds" in hf:
                del hf["Xds"]
        return

    with h5py.File(h5path, "a") as hf:
        n = hf["X"].shape[0]
        cache_ok = (
            "Xds" in hf
            and hf["Xds"].shape == (n, time_ds, feat_sz)
            and hf["Xds"].attrs.get("xds_complete", False)
            and hf["Xds"].attrs.get("ds_factor", None) == cfg.ds_factor
            and hf["Xds"].chunks == (cfg.xds_chunk_rows, time_ds, feat_sz)
        )
        if cache_ok:
            log.info(f"Bộ nhớ đệm Xds hợp lệ ({n} windows).")
            return
        if "Xds" in hf:
            del hf["Xds"]

        chunk_shape = (cfg.xds_chunk_rows, time_ds, feat_sz)
        ds = hf.create_dataset("Xds", shape=(n, time_ds, feat_sz), dtype="float32", chunks=chunk_shape)
        ds.attrs["xds_complete"] = False
        ds.attrs["ds_factor"] = cfg.ds_factor

        chunk = 256
        t0 = time.time()
        for start in range(0, n, chunk):
            end = min(start + chunk, n)
            Xb = hf["X"][start:end]
            Xt = np.stack([_transform(x, cfg.ds_factor) for x in Xb]).astype(np.float32)
            hf["Xds"][start:end] = Xt
        hf["Xds"].attrs["xds_complete"] = True
        log.info(f"Đã tạo cache Xds ({n} windows) trong {(time.time()-t0)/60:.1f} phút.")


def make_generator(idx_arr, h5path, cfg, ent_stats: dict, shuffle=True, augment=False, seed=0):
    """Tạo bộ sinh dữ liệu phân luồng cho tf.data.Dataset với bộ đệm đọc tối ưu."""
    idx_arr = np.array(idx_arr)
    se_med, se_iqr   = ent_stats["SE"]
    spe_med, spe_iqr = ent_stats["SPE"]
    pe_med, pe_iqr   = ent_stats["PE"]
    rng = np.random.RandomState(seed)

    def gen():
        order = rng.permutation(len(idx_arr)) if shuffle else np.arange(len(idx_arr))
        with h5py.File(h5path, "r", rdcc_nbytes=cfg.h5_rdcc_mb * 1024 * 1024,
                       rdcc_nslots=cfg.h5_rdcc_nslots) as hf:
            has_xds = "Xds" in hf
            xds_shape = hf["Xds"].shape[1:] if has_xds else None
            n_full = (len(order) // cfg.batch_size) * cfg.batch_size

            for start in range(0, n_full, cfg.batch_size):
                pos = idx_arr[order[start: start + cfg.batch_size]]
                uid, inv = np.unique(pos, return_inverse=True)
                SEb  = apply_entropy_norm_stats(hf["SE"][uid][inv],  se_med,  se_iqr)
                SPEb = apply_entropy_norm_stats(hf["SPE"][uid][inv], spe_med, spe_iqr)
                PEb  = apply_entropy_norm_stats(hf["PE"][uid][inv],  pe_med,  pe_iqr)
                yb   = hf["y"][uid][inv]
                pre_mask = (yb > 0) if augment else np.zeros_like(yb, dtype=bool)

                if has_xds:
                    keep_mask = ~pre_mask
                    Xt = np.empty((len(pos),) + xds_shape, dtype=np.float32)
                    if keep_mask.any():
                        k_uid, k_inv = np.unique(pos[keep_mask], return_inverse=True)
                        Xt[keep_mask] = hf["Xds"][k_uid][k_inv].astype(np.float32)
                    if pre_mask.any():
                        idxs = np.where(pre_mask)[0]
                        r_uid, r_inv = np.unique(pos[idxs], return_inverse=True)
                        Xb_raw = hf["X"][r_uid][r_inv]
                        for k, i in enumerate(idxs):
                            xa = _augment_window(Xb_raw[k], rng)
                            Xt[i] = _transform(xa, cfg.ds_factor)
                else:
                    Xb = hf["X"][uid][inv]
                    if pre_mask.any():
                        for i in np.where(pre_mask)[0]:
                            Xb[i] = _augment_window(Xb[i], rng)
                    Xt = np.stack([_transform(x, cfg.ds_factor) for x in Xb]).astype(np.float32)

                Et = np.concatenate([SEb, SPEb, PEb], axis=1).astype(np.float32)
                yield {"temporal": Xt, "entropy": Et}, yb.astype(np.float32)
    return gen


def load_split_to_memory(idx, h5path, cfg, ent_stats: dict):
    """Nạp toàn bộ tập dữ liệu đã chọn vào RAM theo đúng thứ tự thời gian."""
    se_med, se_iqr   = ent_stats["SE"]
    spe_med, spe_iqr = ent_stats["SPE"]
    pe_med, pe_iqr   = ent_stats["PE"]

    idx_s = np.sort(idx)
    with h5py.File(h5path, "r", rdcc_nbytes=cfg.h5_rdcc_mb * 1024 * 1024,
                   rdcc_nslots=cfg.h5_rdcc_nslots) as hf:
        if "Xds" in hf:
            Xt = hf["Xds"][idx_s].astype(np.float32)
        else:
            Xb = hf["X"][idx_s]
            Xt = np.stack([_transform(x, cfg.ds_factor) for x in Xb]).astype(np.float32)
        SEb  = apply_entropy_norm_stats(hf["SE"][idx_s],  se_med,  se_iqr)
        SPEb = apply_entropy_norm_stats(hf["SPE"][idx_s], spe_med, spe_iqr)
        PEb  = apply_entropy_norm_stats(hf["PE"][idx_s],  pe_med,  pe_iqr)
        yb   = hf["y"][idx_s]
        ttsb = hf["tts"][idx_s]
        tb   = hf["t"][idx_s]
        fidb = hf["file_id"][idx_s]
    Et = np.concatenate([SEb, SPEb, PEb], axis=1).astype(np.float32)
    return Xt, Et, yb.astype(np.float32), ttsb.astype(np.float32), tb.astype(np.float32), fidb.astype(np.int32)


# ==============================================================================
# MODULE 7: KIẾN TRÚC MÔ HÌNH HỌC SÂU LAI & HÀM MẤT MÁT (MODEL & LOSS)
# ==============================================================================
def build_model(time_ds: int, feat_size: int, entropy_size: int) -> Model:
    """Xây dựng mạng nơ-ron lai: Nhánh Temporal (CNN-BiLSTM) + Nhánh Entropy (MLP)."""
    # ── 7.1. Nhánh Temporal ──
    t_in = Input(shape=(time_ds, feat_size), name="temporal")
    t = Conv1D(32, 7, strides=2, padding="same", kernel_initializer="he_normal", name="c1")(t_in)
    t = BatchNormalization()(t); t = Activation("relu")(t)
    t = Conv1D(64, 5, strides=2, padding="same", kernel_initializer="he_normal", name="c2")(t)
    t = BatchNormalization()(t); t = Activation("relu")(t)
    t = MaxPooling1D(4, name="pool")(t)
    t = Dropout(0.2)(t)
    t = Bidirectional(LSTM(32, dropout=0.1, recurrent_dropout=0.0, return_sequences=False), name="bilstm")(t)
    t = LayerNormalization(name="ln_lstm")(t)
    t = Dense(32, activation="relu", kernel_initializer="he_normal", name="t_proj")(t)

    # ── 7.2. Nhánh Entropy ──
    e_in = Input(shape=(entropy_size,), name="entropy")
    e = Dense(64, activation="relu", kernel_initializer="he_normal", name="e1")(e_in)
    e = Dropout(0.3)(e)
    e = Dense(32, activation="relu", kernel_initializer="he_normal", name="e2")(e)

    # ── 7.3. Hợp nhất đặc trưng (Feature Fusion) ──
    m = Concatenate(name="fusion")([t, e])
    m = Dense(48, activation="relu", kernel_initializer="he_normal", name="h1")(m)
    m = Dropout(0.25)(m)
    out = Dense(1, activation="sigmoid", name="urgency")(m)

    return Model(inputs=[t_in, e_in], outputs=out, name="EEG_Predictor_Rebuild")


def asymmetric_focal_huber_loss(delta=0.5, gamma=1.5, alpha_fn=3.0, alpha_fp=1.0):
    """Hàm tổn thất bất đối xứng kết hợp Focal và Huber Loss (phạt nặng FN)."""
    def loss(y_true, y_pred):
        h = tf.keras.losses.huber(y_true, y_pred, delta=delta)
        focal_w = tf.pow(tf.abs(y_true - y_pred), gamma)
        fn_mask = tf.cast(y_true > y_pred, tf.float32)
        asym_w  = alpha_fn * fn_mask + alpha_fp * (1.0 - fn_mask)
        return tf.reduce_mean(asym_w * focal_w * h)
    loss.__name__ = "asym_focal_huber"
    return loss


# ==============================================================================
# MODULE 8: BỘ LỌC HẬU XỬ LÝ CẢNH BÁO (DUAL-THRESHOLD VOTER & FIRING POWER)
# ==============================================================================
def _find_runs(mask: np.ndarray):
    """Xác định các đoạn liên tục có mask = True."""
    runs, start = [], None
    for i, v in enumerate(mask):
        if v and start is None:    start = i
        elif not v and start is not None:
            runs.append((start, i)); start = None
    if start is not None:
        runs.append((start, len(mask)))
    return runs


def _find_event_runs(mask: np.ndarray, tts_arr: np.ndarray, step_s: float) -> list:
    """Tách các sự kiện tiền cơn riêng biệt dựa vào nhịp đếm lùi của TTS."""
    raw_runs = _find_runs(mask)
    event_runs = []
    for s, e in raw_runs:
        seg_start = s
        for i in range(s + 1, e):
            expected = tts_arr[i - 1] - step_s
            if not np.isclose(tts_arr[i], expected, atol=step_s / 2.0, equal_nan=False):
                event_runs.append((seg_start, i))
                seg_start = i
        event_runs.append((seg_start, e))
    return event_runs


class DualThresholdVoter:
    """Bộ tạo nhịp cảnh báo: Tích lũy Firing Power, cơ chế trễ Hysteresis và khóa trơ thời gian."""
    def __init__(self, cfg: Config):
        assert cfg.thr_off_min > 0
        self.fp_steps = max(1, int(round(cfg.fp_window_s / cfg.step_s)))
        self.suppression_steps = max(1, int(round(cfg.suppression_s / cfg.step_s)))
        self.step_s = cfg.step_s

    def _segment_ids(self, t: np.ndarray) -> np.ndarray:
        """Phát hiện các khoảng trống gián đoạn thời gian để phân tách các đoạn tín hiệu."""
        n = len(t)
        seg = np.zeros(n, dtype=np.int64)
        for i in range(1, n):
            if (t[i] - t[i - 1]) > self.step_s * 1.5:
                seg[i] = seg[i - 1] + 1
            else:
                seg[i] = seg[i - 1]
        return seg

    def _firing_power(self, scores: np.ndarray, thr_on: float, t: Optional[np.ndarray] = None) -> np.ndarray:
        """Tính tỷ lệ kích hoạt trong cửa sổ trượt."""
        pos = (scores >= thr_on).astype(np.float64)
        n = len(scores)

        if t is None:
            csum = np.concatenate(([0.0], np.cumsum(pos)))
            idx  = np.arange(n)
            s    = np.maximum(0, idx - self.fp_steps + 1)
            count = csum[idx + 1] - csum[s]
            window_len = (idx - s + 1).astype(np.float64)
            return count / window_len

        seg = self._segment_ids(t)
        csum = np.concatenate(([0.0], np.cumsum(pos)))
        fp = np.zeros(n, dtype=np.float64)
        seg_start = 0
        for i in range(n):
            if i > 0 and seg[i] != seg[i - 1]:
                seg_start = i
            s = max(seg_start, i - self.fp_steps + 1)
            fp[i] = (csum[i + 1] - csum[s]) / (i - s + 1)
        return fp

    def predict(self, scores: np.ndarray, thr_on: float, thr_off: float,
                t: Optional[np.ndarray] = None) -> np.ndarray:
        """Sinh chuỗi cờ cảnh báo nhị phân (0 hoặc 1)."""
        fp    = self._firing_power(scores, thr_on, t=t)
        alarm = np.zeros(len(scores), dtype=np.int32)
        state, suppress_until = 0, -1
        seg = self._segment_ids(t) if t is not None else None

        for i in range(len(scores)):
            if seg is not None and i > 0 and seg[i] != seg[i - 1]:
                state = 0
                suppress_until = -1
            if state == 0:
                if fp[i] >= thr_on and i > suppress_until:
                    state = 1
            else:
                if fp[i] < thr_off:
                    state = 0
                    suppress_until = i + self.suppression_steps
            alarm[i] = state
        return alarm

    def count_episodes(self, alarm: np.ndarray) -> int:
        """Đếm số đợt cảnh báo độc lập."""
        n, in_alarm = 0, False
        for v in alarm:
            if v == 1 and not in_alarm: n += 1; in_alarm = True
            elif v == 0:                in_alarm = False
        return n


# ==============================================================================
# MODULE 9: ĐÁNH GIÁ LÂM SÀNG, HIỆU CHUẨN XÁC SUẤT & CHỌN NGƯỠNG LTT
# ==============================================================================
def metrics_one_file(y_true, scores, tts_arr, voter: DualThresholdVoter,
                     thr_on: float, thr_off: float, cfg: Config,
                     t: Optional[np.ndarray] = None) -> dict:
    """Tính toán chỉ số lâm sàng (Sensitivity, FAR, Warning Time) trên 1 file đơn lẻ."""
    alarm = voter.predict(scores, thr_on, thr_off, t=t)
    y_bin = (y_true > 0).astype(int)

    runs = _find_event_runs(y_bin == 1, tts_arr, cfg.step_s)
    tp = fn_late = fn_miss = 0
    warn_times = []
    for s, e in runs:
        r_alarm  = alarm[s:e]
        r_tts    = tts_arr[s:e]
        valid    = np.where((r_alarm == 1) & (r_tts >= cfg.sph_s))[0]
        any_hit  = np.where(r_alarm == 1)[0]
        if len(valid) > 0:
            tp += 1
            tts_at = r_tts[valid[0]]
            if np.isfinite(tts_at):
                warn_times.append(tts_at)
        elif len(any_hit) > 0:
            fn_late += 1
        else:
            fn_miss += 1

    n_events   = tp + fn_late + fn_miss
    sensitivity = tp / n_events if n_events > 0 else np.nan

    inter_mask = (y_true == 0)
    inter_h    = inter_mask.sum() * cfg.step_s / 3600.0
    fa_ep      = voter.count_episodes(alarm[inter_mask])
    far        = fa_ep / (inter_h + 1e-8)

    return {
        "alarm":       alarm,
        "sensitivity": sensitivity,
        "far_per_h":   far,
        "fa_episodes": fa_ep,
        "inter_h":     inter_h,
        "tp": tp, "fn_late": fn_late, "fn_miss": fn_miss, "n_events": n_events,
        "warn_times":   warn_times,
        "n_warn_times": len(warn_times),
        "median_warn":  float(np.median(warn_times)) if warn_times else np.nan,
        "mean_warn":    float(np.mean(warn_times))   if warn_times else np.nan,
    }


def metrics_grouped(y_true, scores, tts_arr, file_ids, voter, thr_on, thr_off, cfg,
                    t: Optional[np.ndarray] = None):
    """Tính và gộp kết quả đánh giá theo từng file độc lập."""
    alarm_full = np.zeros(len(y_true), dtype=np.int32)
    agg = dict(tp=0, fn_late=0, fn_miss=0, n_events=0,
               fa_episodes=0, inter_h=0.0, warn_times=[])

    for fid in np.unique(file_ids):
        g = np.where(file_ids == fid)[0]
        t_g = t[g] if t is not None else None
        m = metrics_one_file(y_true[g], scores[g], tts_arr[g], voter, thr_on, thr_off, cfg, t=t_g)
        alarm_full[g] = m["alarm"]
        for k in ("tp", "fn_late", "fn_miss", "n_events", "fa_episodes"):
            agg[k] += m[k]
        agg["inter_h"]   += m["inter_h"]
        agg["warn_times"] += m["warn_times"]

    n = agg["n_events"]
    lats = agg["warn_times"]
    return {
        **agg,
        "alarm":       alarm_full,
        "sensitivity": agg["tp"] / n if n > 0 else np.nan,
        "far_per_h":   agg["fa_episodes"] / (agg["inter_h"] + 1e-8),
        "median_warn":  float(np.median(lats)) if lats else np.nan,
        "mean_warn":    float(np.mean(lats))   if lats else np.nan,
        "n_files":     len(np.unique(file_ids)),
    }


def fit_platt_scaling(val_scores: np.ndarray, y_val: np.ndarray, cfg: "Config" = None):
    """Hiệu chuẩn xác suất đầu ra bằng Platt Scaling trong không gian logit."""
    y_bin = (y_val > 0).astype(int)
    n_pos = int(y_bin.sum())
    n_neg = int(len(y_bin) - n_pos)
    min_class_n = cfg.platt_min_class_n if cfg is not None else 30
    min_range   = cfg.platt_min_calibrated_range if cfg is not None else 0.05

    if n_pos == 0 or n_neg == 0 or min(n_pos, n_neg) < min_class_n:
        return None, "Không đủ mẫu của lớp thiểu số để hiệu chuẩn."

    _eps = 1e-6
    val_logits = scipy_logit(np.clip(val_scores, _eps, 1 - _eps))

    lr = LogisticRegression(solver="lbfgs")
    lr.fit(val_logits.reshape(-1, 1), y_bin)

    calibrated_val = lr.predict_proba(val_logits.reshape(-1, 1))[:, 1]
    cal_range = float(calibrated_val.max() - calibrated_val.min())
    if cal_range < min_range:
        return None, f"Dải giá trị sau hiệu chuẩn quá hẹp ({cal_range:.3f})."

    def calibrate(scores: np.ndarray) -> np.ndarray:
        s_logits = scipy_logit(np.clip(scores, _eps, 1 - _eps))
        return lr.predict_proba(s_logits.reshape(-1, 1))[:, 1]

    return calibrate, None


def hb_pvalue(r_hat: float, n: int, alpha: float) -> float:
    """Tính p-value theo bất đẳng thức Hoeffding-Bentkus."""
    if r_hat >= alpha:
        return 1.0
    bentkus_p = np.e * float(scipy_binom.cdf(np.ceil(n * r_hat), n, alpha))

    def _h1(a, b):
        a = np.clip(a, 1e-12, 1 - 1e-12)
        b = np.clip(b, 1e-12, 1 - 1e-12)
        return a * np.log(a / b) + (1 - a) * np.log((1 - a) / (1 - b))

    hoeffding_p = float(np.exp(-n * _h1(min(r_hat, alpha), alpha)))
    return float(min(1.0, bentkus_p, hoeffding_p))


def select_threshold_ltt(inter_scores: np.ndarray, alpha: float, delta: float):
    """Chọn ngưỡng kích hoạt theo khung Learn-Then-Test và Fixed Sequence Testing."""
    n = len(inter_scores)
    if n == 0:
        return float("inf"), 0, 0

    sorted_desc = np.sort(np.unique(inter_scores))[::-1]
    candidates = np.concatenate([[sorted_desc[0] + 1e-6], sorted_desc])

    best = candidates[0]
    n_accepted = 0
    for i, c in enumerate(candidates):
        r_hat = float(np.mean(inter_scores >= c))
        p = hb_pvalue(r_hat, n, alpha)
        if p <= delta:
            best = c
            n_accepted = i + 1
        else:
            break
    return float(best), len(candidates), n_accepted


def select_threshold(y_val, val_scores, val_tts, val_fids, voter, cfg, val_t=None):
    """Lựa chọn cặp ngưỡng (thr_on, thr_off) theo các chế độ cấu hình."""
    if cfg.threshold_mode == "absolute":
        thr_on, thr_off = cfg.fixed_thr_on, cfg.fixed_thr_off
        return thr_on, thr_off

    elif cfg.threshold_mode == "relative":
        inter_scores = val_scores[y_val == 0]
        if len(inter_scores) < 30:
            inter_scores = val_scores

        pct_on  = float(np.clip(100.0 - cfg.interictal_fa_pct, 0.5, 99.5))
        pct_off = float(np.clip(pct_on - cfg.relative_pct_margin, 0.5, pct_on - 0.01))

        thr_on  = float(np.percentile(inter_scores, pct_on))
        thr_off = float(np.percentile(inter_scores, pct_off))
        _gap = 0.01
        thr_on  = max(thr_on, cfg.thr_off_min + _gap)
        thr_off = float(np.clip(thr_off, cfg.thr_off_min, thr_on - _gap))
        return thr_on, thr_off

    elif cfg.threshold_mode == "learn_then_test":
        inter_scores = val_scores[y_val == 0]
        if len(inter_scores) < 10:
            inter_scores = val_scores

        thr_on, n_tested, n_accepted = select_threshold_ltt(
            inter_scores, alpha=cfg.ltt_target_risk, delta=cfg.ltt_delta)

        rank_on = float(np.mean(inter_scores <= thr_on)) * 100.0
        pct_off = float(np.clip(rank_on - cfg.relative_pct_margin, 0.5, rank_on - 0.01))
        thr_off = float(np.percentile(inter_scores, pct_off)) if len(inter_scores) > 0 else cfg.thr_off_min

        _gap = 0.01
        thr_on  = max(thr_on, cfg.thr_off_min + _gap)
        thr_off = float(np.clip(thr_off, cfg.thr_off_min, thr_on - _gap))
        return thr_on, thr_off

    else:
        raise ValueError(f"Chế độ ngưỡng không hợp lệ: {cfg.threshold_mode}")


# ==============================================================================
# MODULE 10: KHUNG KIỂM ĐỊNH CHÉO LOSO-CV (LEAVE-ONE-SEIZURE-OUT)
# ==============================================================================
def get_seizure_file_ids(file_ids, y_all):
    """Tìm danh sách ID các file có chứa sự kiện tiền cơn."""
    is_pre = y_all > 0
    return [fid for fid in np.unique(file_ids) if np.any(is_pre[file_ids == fid])]


def generate_loso_folds(file_ids, y_all):
    """Tạo các fold LOSO-CV kết hợp chia xoay vòng file interictal thuần cho Test và Calib."""
    sz_files   = get_seizure_file_ids(file_ids, y_all)
    all_files  = np.unique(file_ids)
    pure_files = [f for f in all_files if f not in sz_files]
    N = len(sz_files)

    if N < 2:
        raise ValueError(f"Yêu cầu tối thiểu 2 file chứa cơn để chạy LOSO-CV. Hiện có: {N}.")

    pure_test_groups = [[] for _ in range(N)]
    for k, pf in enumerate(pure_files):
        pure_test_groups[k % N].append(pf)

    offset = max(1, N // 2)
    pure_calib_groups = [[] for _ in range(N)]
    for k, pf in enumerate(pure_files):
        target = (k + offset) % N
        if pf not in pure_test_groups[target]:
            pure_calib_groups[target].append(pf)

    folds = []
    for i, test_fid in enumerate(sz_files):
        val_fid      = sz_files[(i + 1) % N]
        extra_pure   = pure_test_groups[i]
        extra_calib  = pure_calib_groups[i]
        excluded     = {test_fid, val_fid, *extra_pure, *extra_calib}
        train_fids   = [f for f in all_files if f not in excluded]
        test_fids_all  = [test_fid, *extra_pure]
        calib_fids_all = [val_fid, *extra_calib]

        folds.append({
            "fold":             i,
            "test_fid":         test_fid,
            "val_fid":          val_fid,
            "extra_pure_fids":  extra_pure,
            "extra_calib_fids": extra_calib,
            "train_idx":        np.where(np.isin(file_ids, train_fids))[0],
            "val_idx":          np.where(file_ids == val_fid)[0],
            "calib_idx":        np.where(np.isin(file_ids, calib_fids_all))[0],
            "test_idx":         np.where(np.isin(file_ids, test_fids_all))[0],
        })
    return folds


def group_split_train_val(tr_idx: np.ndarray, file_ids: np.ndarray, y_all: np.ndarray,
                          frac: float, rng: np.random.RandomState):
    """Tách tập Inner Validation nguyên vẹn theo file trước khi cân bằng dữ liệu."""
    grp_file_ids = file_ids[tr_idx]
    y_tr = y_all[tr_idx]

    file_has_preictal, file_n_pre, file_n_total = {}, {}, {}
    for f in np.unique(grp_file_ids):
        mask_f = grp_file_ids == f
        n_pre  = int(np.sum(y_tr[mask_f] > 0))
        file_has_preictal[f] = n_pre > 0
        file_n_pre[f]        = n_pre
        file_n_total[f]      = int(np.sum(mask_f))

    pre_files  = np.array([f for f, has in file_has_preictal.items() if has])
    pure_files = np.array([f for f, has in file_has_preictal.items() if not has])
    rng.shuffle(pre_files)
    rng.shuffle(pure_files)

    def _pick_val_files(files, size_of):
        if len(files) <= 1:
            return []
        jitter = rng.uniform(0, 1e-6, size=len(files))
        sizes = np.array([size_of[f] for f in files], dtype=np.float64) + jitter
        order = np.argsort(sizes)
        files_sorted = files[order]

        total  = sum(size_of[f] for f in files)
        target = total * frac
        chosen, acc = [], 0
        for f in files_sorted:
            if len(chosen) >= len(files) - 1:
                break
            if acc > 0 and acc + size_of[f] > target * 1.5:
                break
            chosen.append(f)
            acc += size_of[f]
            if acc >= target:
                break
        return chosen

    val_pre_files  = _pick_val_files(pre_files,  file_n_pre)
    val_pure_files = _pick_val_files(pure_files, file_n_total)
    val_files = val_pre_files + val_pure_files
    val_mask  = np.isin(grp_file_ids, val_files)

    tr_fit_unbal_idx = tr_idx[~val_mask]
    inner_val_idx    = tr_idx[val_mask]
    return tr_fit_unbal_idx, inner_val_idx


def run_single_fold(fold_info: dict, file_ids, y_all, tts_all, h5path: str, cfg: Config,
                    n_ch: int, time_ds: int, n_bands: int) -> dict:
    """Huấn luyện và đánh giá trên một fold LOSO-CV cụ thể."""
    fi        = fold_info["fold"]
    tr_idx    = fold_info["train_idx"]
    val_idx   = fold_info["val_idx"]
    calib_idx = fold_info.get("calib_idx", val_idx)
    te_idx    = fold_info["test_idx"]

    log.info(f"\n--- FOLD {fi+1} | Test: {fold_info['test_fid']} | Val: {fold_info['val_fid']} ---")

    _split_rng = np.random.RandomState(5000 + fi)
    tr_fit_unbal, inner_val = group_split_train_val(tr_idx, file_ids, y_all, cfg.inner_val_frac, _split_rng)

    y_tr_fit_unbal = y_all[tr_fit_unbal]
    rng   = np.random.RandomState(42 + fi)
    idx_i = tr_fit_unbal[y_tr_fit_unbal == 0.0]
    idx_p = tr_fit_unbal[y_tr_fit_unbal > 0.0]
    if len(idx_p) == 0:
        return None
    n0     = min(len(idx_i), len(idx_p) * 2)
    tr_fit = np.concatenate([rng.choice(idx_i, n0, replace=False), idx_p])
    rng.shuffle(tr_fit)

    ent_stats = compute_entropy_norm_stats(h5path, tr_idx)

    feat_size    = n_bands * n_ch
    entropy_size = 3 * n_ch
    out_sig = (
        {"temporal": tf.TensorSpec((None, time_ds, feat_size), tf.float32),
         "entropy":  tf.TensorSpec((None, entropy_size),       tf.float32)},
        tf.TensorSpec((None,), tf.float32),
    )
    train_ds = tf.data.Dataset.from_generator(
        make_generator(tr_fit, h5path, cfg, ent_stats, shuffle=True, augment=True, seed=3000 + fi),
        output_signature=out_sig,
    ).repeat().prefetch(tf.data.AUTOTUNE)

    tf.keras.backend.clear_session()
    tf.random.set_seed(1000 + fi)
    np.random.seed(2000 + fi)
    model = build_model(time_ds, feat_size, entropy_size)

    steps = max(1, len(tr_fit) // cfg.batch_size)
    lr_schedule = tf.keras.optimizers.schedules.CosineDecay(
        initial_learning_rate=cfg.lr_init,
        decay_steps=steps * cfg.epochs,
        alpha=cfg.lr_min / cfg.lr_init,
    )
    model.compile(
        optimizer=tf.keras.optimizers.Adam(lr_schedule, clipnorm=1.0),
        loss=asymmetric_focal_huber_loss(alpha_fn=cfg.alpha_fn, alpha_fp=cfg.alpha_fp),
        metrics=["mae"],
    )

    ckpt_path = os.path.join(cfg.output_dir, f"fold{fi}_best.keras")
    callbacks = [
        EarlyStopping(monitor="val_loss", patience=cfg.patience, restore_best_weights=True, verbose=0),
        ModelCheckpoint(ckpt_path, monitor="val_loss", save_best_only=True, verbose=0),
    ]

    Xv_in, Ev_in, yv_in, _, _, _ = load_split_to_memory(inner_val, h5path, cfg, ent_stats)
    val_data = ({"temporal": Xv_in, "entropy": Ev_in}, yv_in)

    history = model.fit(
        train_ds,
        validation_data=val_data,
        validation_batch_size=cfg.batch_size,
        epochs=cfg.epochs,
        steps_per_epoch=steps,
        callbacks=callbacks,
        verbose=0,
    )

    Xv, Ev, yv, ttsv, tv, fidv = load_split_to_memory(calib_idx, h5path, cfg, ent_stats)
    Xt, Et, yt, ttst, tt, fidt = load_split_to_memory(te_idx,    h5path, cfg, ent_stats)

    pred_val  = model.predict({"temporal": Xv, "entropy": Ev}, batch_size=cfg.batch_size, verbose=0).flatten()
    pred_test = model.predict({"temporal": Xt, "entropy": Et}, batch_size=cfg.batch_size, verbose=0).flatten()

    pred_val_raw, pred_test_raw = pred_val.copy(), pred_test.copy()
    if cfg.use_calibration:
        calibrate_fn, reason = fit_platt_scaling(pred_val, yv, cfg)
        if calibrate_fn is not None:
            pred_val  = calibrate_fn(pred_val)
            pred_test = calibrate_fn(pred_test)

    y_bin_te = (yt > 0).astype(int)
    auc_roc = auc_pr = np.nan
    if len(np.unique(y_bin_te)) > 1:
        auc_roc = roc_auc_score(y_bin_te, pred_test)
        auc_pr  = average_precision_score(y_bin_te, pred_test)

    voter = DualThresholdVoter(cfg)
    thr_on, thr_off = select_threshold(yv, pred_val, ttsv, fidv, voter, cfg, val_t=tv)

    diag_path = os.path.join(cfg.output_dir, f"fold{fi}_score_diag.npz")
    np.savez(
        diag_path,
        test_fid=fold_info["test_fid"], val_fid=fold_info["val_fid"], fold=fi,
        pred_val_raw=pred_val_raw, pred_val_cal=pred_val, y_val=yv, tts_val=ttsv, fid_val=fidv,
        pred_test_raw=pred_test_raw, pred_test_cal=pred_test, y_test=yt, tts_test=ttst, fid_test=fidt,
        thr_on=thr_on, thr_off=thr_off,
        threshold_mode=cfg.threshold_mode, ltt_target_risk=cfg.ltt_target_risk, ltt_delta=cfg.ltt_delta,
    )

    m = metrics_grouped(yt, pred_test, ttst, fidt, voter, thr_on, thr_off, cfg, t=tt)

    log.info(f"  AUC-ROC={auc_roc:.3f} | Sens={m['sensitivity']:.3f} ({m['tp']}/{m['n_events']}) | FAR={m['far_per_h']:.3f}/h")
    return {
        "fold":        fi,
        "test_fid":    fold_info["test_fid"],
        "auc_roc":     auc_roc,
        "auc_pr":      auc_pr,
        "thr_on":      thr_on,
        "thr_off":     thr_off,
        **{k: m[k] for k in ("sensitivity", "far_per_h", "fa_episodes", "inter_h",
                              "tp", "fn_late", "fn_miss", "n_events",
                              "warn_times", "median_warn", "mean_warn")},
        "history":     history.history,
        "pred_test":   pred_test.tolist(),
        "y_bin_te":    y_bin_te.tolist(),
    }


def aggregate_and_report(fold_results: list, cfg: Config):
    """Tổng hợp toàn bộ chỉ số qua các fold, vẽ biểu đồ và xuất báo cáo JSON."""
    valid = [r for r in fold_results if r is not None]
    if not valid:
        return

    N = len(valid)
    all_tp = sum(r["tp"] for r in valid)
    all_N  = sum(r["n_events"] for r in valid)
    all_FA = sum(r["fa_episodes"] for r in valid)
    all_h  = sum(r["inter_h"] for r in valid)
    all_warns = [w for r in valid for w in r["warn_times"]]

    overall_sens = all_tp / all_N if all_N > 0 else np.nan
    overall_far  = all_FA / all_h if all_h > 0 else np.nan
    overall_med_warn = float(np.median(all_warns)) if all_warns else np.nan
    overall_mean_warn = float(np.mean(all_warns)) if all_warns else np.nan

    auc_roc_list = [r["auc_roc"] for r in valid if not np.isnan(r["auc_roc"])]
    auc_pr_list  = [r["auc_pr"]  for r in valid if not np.isnan(r["auc_pr"])]

    log.info(f"\n{'='*60}")
    log.info(f"TỔNG KẾT LOSO-CV ({N} FOLDS) — BỆNH NHÂN: {cfg.patient}")
    log.info(f"{'='*60}")
    log.info(f"  AUC-ROC: {np.mean(auc_roc_list):.3f} ± {np.std(auc_roc_list):.3f}")
    log.info(f"  Độ nhạy (Sensitivity): {overall_sens:.3f} ({all_tp}/{all_N} cơn)")
    log.info(f"  Tỷ lệ báo giả (FAR): {overall_far:.3f}/h ({all_FA} FA / {all_h:.1f}h)")
    log.info(f"  Warning Time trung vị: {overall_med_warn:.0f}s")

    # Vẽ biểu đồ tổng kết 6 ô
    fig, axes = plt.subplots(2, 3, figsize=(18, 10))
    if valid[0]["history"].get("loss"):
        for r in valid:
            axes[0,0].plot(r["history"]["loss"], alpha=0.4, color="steelblue")
            axes[0,0].plot(r["history"]["val_loss"], alpha=0.4, color="tomato")
        axes[0,0].set_title("Train/Val Loss"); axes[0,0].legend(["Train", "Val"])

    for r in valid:
        pred = np.array(r["pred_test"]); yb = np.array(r["y_bin_te"])
        if len(np.unique(yb)) > 1:
            fpr, tpr, _ = roc_curve(yb, pred)
            axes[0,1].plot(fpr, tpr, alpha=0.5, label=f"Fold {r['fold']+1}")
    axes[0,1].plot([0,1],[0,1],"k--"); axes[0,1].set_title("ROC Curves"); axes[0,1].legend(fontsize=8)

    for r in valid:
        pred = np.array(r["pred_test"]); yb = np.array(r["y_bin_te"])
        if len(np.unique(yb)) > 1:
            prec, rec, _ = precision_recall_curve(yb, pred)
            axes[0,2].plot(rec, prec, alpha=0.5, label=f"Fold {r['fold']+1}")
    axes[0,2].set_title("PR Curves"); axes[0,2].legend(fontsize=8)

    fold_sens = [r["sensitivity"] if not np.isnan(r["sensitivity"]) else 0 for r in valid]
    axes[1,0].bar(range(1, N+1), fold_sens, color="steelblue", alpha=0.8)
    axes[1,0].axhline(overall_sens, color="red", linestyle="--")
    axes[1,0].set_title("Sensitivity Per Fold")

    fold_far = [r["far_per_h"] for r in valid]
    axes[1,1].bar(range(1, N+1), fold_far, color="tomato", alpha=0.8)
    axes[1,1].axhline(overall_far, color="red", linestyle="--")
    axes[1,1].set_title("FAR Per Fold")

    if all_warns:
        axes[1,2].hist([w/60 for w in all_warns], bins=15, color="purple", alpha=0.7)
        axes[1,2].set_title("Warning Time (phút)")

    plt.suptitle(f"LOSO-CV — {cfg.patient} | Sens={overall_sens:.2f} | FAR={overall_far:.2f}/h", fontweight="bold")
    plt.tight_layout()
    out_png = os.path.join(cfg.output_dir, f"loso_cv_{cfg.patient}.png")
    plt.savefig(out_png, dpi=130)

    # Xuất tóm tắt JSON
    summary = {
        "patient": cfg.patient,
        "n_folds": N,
        "auc_roc_mean": float(np.mean(auc_roc_list)),
        "auc_roc_std":  float(np.std(auc_roc_list)),
        "auc_pr_mean":  float(np.mean(auc_pr_list)),
        "overall_sensitivity": float(overall_sens),
        "overall_far_per_h":   float(overall_far),
        "warn_time_median_s":  float(overall_med_warn),
        "n_detected":      all_tp,
        "n_total_seizures": all_N,
        "total_fa":        all_FA,
        "total_inter_h":   all_h,
    }
    json_path = os.path.join(cfg.output_dir, f"summary_{cfg.patient}.json")
    with open(json_path, "w", encoding="utf-8") as jf:
        json.dump(summary, jf, indent=2, ensure_ascii=False)


def run_loso_cv(cfg: Config):
    """Điểm vào thực thi quy trình kiểm định chéo LOSO-CV."""
    with h5py.File(cfg.hdf5_path, "r") as hf:
        y_all    = hf["y"][:]
        tts_all  = hf["tts"][:]
        file_ids = hf["file_id"][:]
        n_ch     = int(hf.attrs["n_channels"])
        X_shape  = hf["X"].shape

    n_bands  = X_shape[1]
    time_ds  = X_shape[3] // cfg.ds_factor
    feat_sz  = n_bands * n_ch

    ensure_xds_cache(cfg.hdf5_path, cfg, time_ds, feat_sz)
    folds = generate_loso_folds(file_ids, y_all)

    results = []
    for fold_info in folds:
        r = run_single_fold(fold_info, file_ids, y_all, tts_all, cfg.hdf5_path, cfg, n_ch, time_ds, n_bands)
        results.append(r)

    aggregate_and_report(results, cfg)


